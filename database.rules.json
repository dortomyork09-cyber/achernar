{
  "rules": {
    "keys": {
      "$r": {
        ".read": false,
        ".write": "auth != null && ((!data.exists() && newData.hasChildren(['e','c'])) || (!newData.exists() && root.child('rooms/'+$r+'/meta/owner').val() === auth.uid))"
      }
    },
    "access": {
      "$r": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && root.child('keys/'+$r).exists() && (!newData.exists() || newData.val() === root.child('keys/'+$r+'/e').val() || newData.val() === root.child('keys/'+$r+'/c').val())"
        }
      }
    },
    "rooms": {
      "$r": {
        ".read": "auth != null",
        ".write": "auth != null && data.child('meta/owner').val() === auth.uid",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid && newData.parent().parent().parent().child('keys/'+$r).exists()) || data.child('owner').val() === auth.uid)"
        },
        "items": {
          ".write": "auth != null && root.child('keys/'+$r).exists() && (root.child('rooms/'+$r+'/meta/owner').val() === auth.uid || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/e').val())"
        },
        "links": {
          ".write": "auth != null && root.child('keys/'+$r).exists() && (root.child('rooms/'+$r+'/meta/owner').val() === auth.uid || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/e').val())"
        },
        "strokes": {
          ".write": "auth != null && root.child('keys/'+$r).exists() && (root.child('rooms/'+$r+'/meta/owner').val() === auth.uid || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/e').val())"
        },
        "comments": {
          ".write": "auth != null && root.child('keys/'+$r).exists() && (root.child('rooms/'+$r+'/meta/owner').val() === auth.uid || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/e').val() || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/c').val())",
          "$c": {
            ".validate": "newData.isString() && newData.val().length < 20000"
          }
        },
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "$other": {
          ".validate": false
        },
        "chat": {
          ".write": "auth != null && root.child('keys/'+$r).exists() && (root.child('rooms/'+$r+'/meta/owner').val() === auth.uid || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/e').val() || root.child('access/'+$r+'/'+auth.uid).val() === root.child('keys/'+$r+'/c').val())",
          "$m": {
            ".validate": "newData.isString() && newData.val().length < 4000"
          }
        }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "rooms": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "inbox": {
          "$pair": {
            ".write": "auth != null && auth.provider !== 'anonymous' && (auth.uid === $uid || ($pair.beginsWith(auth.uid+'_') || $pair.endsWith('_'+auth.uid)))"
          }
        }
      }
    },
    "dms": {
      "$pair": {
        ".read": "auth != null && ($pair.beginsWith(auth.uid+'_') || $pair.endsWith('_'+auth.uid))",
        "$m": {
          ".write": "auth != null && auth.provider !== 'anonymous' && !data.exists() && ($pair.beginsWith(auth.uid+'_') || $pair.endsWith('_'+auth.uid))",
          ".validate": "newData.isString() && newData.val().length < 4000"
        }
      }
    }
  }
}